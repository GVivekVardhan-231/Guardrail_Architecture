# LLM Configuration (Optional: Leave empty to use built-in local Demo Provider)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=demo

# Database Configuration
DATABASE_URL=sqlite:///./guardrail.db

# Risk Scoring Thresholds (0-100)
RISK_THRESHOLD_LOW=25
RISK_THRESHOLD_MEDIUM=50
RISK_THRESHOLD_HIGH=75

# Detector Weights (Must sum to 1.0)
WEIGHT_RULES=0.25
WEIGHT_ML=0.25
WEIGHT_SEMANTIC=0.25
WEIGHT_CONTEXT=0.15
WEIGHT_OBFUSCATION=0.10

# Security and Server Settings
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO
